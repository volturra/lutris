#!/usr/bin/env bash
# Block pushes to the official Lutris GitHub org (lutris/*).
# This clone is for volturra; do not treat lutris/lutris as a push target.
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"

# Drain stdin (ref lines). We reject the whole push, not individual refs.
cat >/dev/null

urls=("$remote_url")
if [[ -n "$remote_name" ]]; then
  configured="$(git remote get-url --push "$remote_name" 2>/dev/null || true)"
  if [[ -n "$configured" ]]; then
    urls+=("$configured")
  fi
  fetch_url="$(git remote get-url "$remote_name" 2>/dev/null || true)"
  if [[ -n "$fetch_url" ]]; then
    urls+=("$fetch_url")
  fi
fi

is_official_lutris() {
  local value="$1"
  local lowered
  lowered="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"

  if [[ "$lowered" == "lutris" ]]; then
    return 0
  fi

  # Match github.com/lutris/ and git@github.com:lutris/ (and GitLab mirrors).
  if [[ "$lowered" =~ (github\.com|gitlab\.com)[:/]+lutris/ ]]; then
    return 0
  fi

  return 1
}

if is_official_lutris "$remote_name"; then
  echo "error: refusing to push to remote '$remote_name'." >&2
  echo "error: this clone must not push anything to lutris/*." >&2
  exit 1
fi

for url in "${urls[@]}"; do
  if is_official_lutris "$url"; then
    echo "error: refusing to push to lutris/* ($url)." >&2
    echo "error: this clone must not push anything to the official Lutris remotes." >&2
    exit 1
  fi
done

exit 0
